# Database (get the team connection string from the team leader, privately)
MONGODB_URI=

# Auth: generate each secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Set to false only if your browser rejects Secure cookies on http://localhost
COOKIE_SECURE=true

# Seed script: the admin account created by "npm run seed"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments and exchange rates (used by later modules)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=

# One currency for every price on the platform (PAY-04). USD until the TA confirms.
PLATFORM_CURRENCY=USD

PORT=3001